# ─── Indian Rail APIs ───────────────────────────────────────────────────────
INDIAN_RAIL_API_KEY=your_key_here
RAPIDAPI_KEY=your_rapidapi_key_here
APIFY_TOKEN=your_apify_token_here
DATAGOV_API_KEY=your_datagov_key_here

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=railsync
POSTGRES_USER=railsync_user
POSTGRES_PASSWORD=change_me_in_production

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_minimum_32_characters_long
JWT_REFRESH_SECRET=change_me_minimum_32_characters_long

# ─── Notifications ───────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=RailSync

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── MinIO (Object Storage) ──────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ─── LLM ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development

# Frontend → backend base URL. Read at build time by Vite, so it must be set on
# the Vercel project before the build, not injected at runtime.
VITE_API_URL=http://localhost:8000
